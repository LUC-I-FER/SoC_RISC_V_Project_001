#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x58adf77f7dc0 .scope module, "tb_main" "tb_main" 2 1;
 .timescale 0 0;
v0x58adf77f97b0_0 .var "clk", 0 0;
v0x58adf77f9ba0_0 .var "counter", 3 0;
E_0x58adf77f8460 .event posedge, v0x58adf77f97b0_0;
    .scope S_0x58adf77f7dc0;
T_0 ;
    %delay 5, 0;
    %load/vec4 v0x58adf77f97b0_0;
    %inv;
    %store/vec4 v0x58adf77f97b0_0, 0, 1;
    %jmp T_0;
    .thread T_0;
    .scope S_0x58adf77f7dc0;
T_1 ;
    %wait E_0x58adf77f8460;
    %load/vec4 v0x58adf77f9ba0_0;
    %addi 1, 0, 4;
    %assign/vec4 v0x58adf77f9ba0_0, 0;
    %vpi_call 2 11 "$display", "Time: %0t | Counter: %d", $time, v0x58adf77f9ba0_0 {0 0 0};
    %jmp T_1;
    .thread T_1;
    .scope S_0x58adf77f7dc0;
T_2 ;
    %vpi_call 2 17 "$dumpfile", "outputs/vcd_files/waveform.vcd" {0 0 0};
    %vpi_call 2 18 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x58adf77f7dc0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x58adf77f97b0_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x58adf77f9ba0_0, 0, 4;
    %vpi_call 2 24 "$display", "--- Simulation Started ---" {0 0 0};
    %delay 50, 0;
    %vpi_call 2 29 "$display", "--- Simulation Complete ---" {0 0 0};
    %vpi_call 2 30 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "tb_main.v";
